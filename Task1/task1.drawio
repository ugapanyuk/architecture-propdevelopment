        <mxCell id="CgIq5uQkF8jW7eY9p0qP-31" value="" style="endArrow=none;html=1;rounded=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;endFill=0;" parent="1" source="CgIq5uQkF8jW7eY9p0qP-30" target="CgIq5uQkF8jW7eY9p0qP-28" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="1240" y="1020" as="sourcePoint" />
