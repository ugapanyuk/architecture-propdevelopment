          </mxGeometry>
        </mxCell>
        <mxCell id="CgIq5uQkF8jW7eY9p0qP-32" value="Причина: Утрата финансовых данных или ключей к госсистемам может полностью остановить&amp;nbsp; деятельность компании, привести к огромным штрафам и невозможности проводить сделки. Несмотря на наличие бэкапов, сам факт инцидента и время на восстановление несут критические риски." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="830" y="1200" width="300" height="110" as="geometry" />
        </mxCell>
