        </mxCell>
        <mxCell id="CgIq5uQkF8jW7eY9p0qP-12" value="Риск: Искажение данных&lt;br&gt;Оценка: Незначительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
